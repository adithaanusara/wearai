# apps/web: where the store API runs. The site proxies /api/* there and calls it from the server.
# Read at build and start time, so set it in production too.
API_URL=http://localhost:8000

# apps/api (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://wearai:wearai@localhost:5432/wearai
CORS_ORIGINS=["http://localhost:3000"]
# Set to true in production (HTTPS) so the session cookie is only sent securely
COOKIE_SECURE=false

# Chat assistant (apps/api). The key stays on the server: never put it in the website's settings.
# Leave it empty to switch the assistant off; the chat then says it is unavailable.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5
# Use a long random value in production. It is used to hash visitors' addresses for rate limits.
# CHAT_HASH_SALT=

# PayHere (online payment). Leave blank to disable card payment.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
# Where the website and this API are actually reachable. PayHere's payment notification needs
# API_PUBLIC_URL to be a real public address; both default to localhost for development.
# SITE_URL=http://localhost:3000
# API_PUBLIC_URL=http://localhost:8000

# Product images (apps/api). "local" (default) keeps files on disk; leave the rest blank.
# IMAGE_STORAGE=cloudinary
# Copy this exactly as Cloudinary's dashboard shows it: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=

# Two-factor authentication (apps/api, opt-in for staff and admin accounts). Leave blank to
# disable 2FA everywhere: setup is refused, and never change this once anyone has turned 2FA on.
# A Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=
